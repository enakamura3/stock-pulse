# Configuração do Caddy para Produção, Homelab e Teste Local

# Domínio do Frontend (Produção)
stock-pulse.com, www.stock-pulse.com {
	# Habilita compressão de conteúdo
	encode zstd gzip

	# Headers de Segurança (LOW-3)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Rotas da API e WebSockets
	@api path /api/* /api
	reverse_proxy @api backend:8080

	# Proxy reverso direcionando para o container Next.js
	reverse_proxy frontend:3000
}

# Domínio do Backend (Produção - API dedicada)
api.stock-pulse.com {
	# Habilita compressão de conteúdo
	encode zstd gzip

	# Bloqueia acesso externo ao endpoint de métricas do Prometheus (LOW-4)
	@metrics path /metrics /metrics/*
	respond @metrics "Not Found" 404

	# Headers de Segurança (LOW-3)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Proxy reverso direcionando para o container Go
	reverse_proxy backend:8080
}

# Bloco para Homelab e Desenvolvimento Local (Acesso HTTP na porta 80 por qualquer IP local ou localhost)
:80, http://stock-pulse.localhost, http://localhost {
	encode zstd gzip

	# Bloqueia acesso externo ao endpoint de métricas do Prometheus (LOW-4)
	@metrics path /metrics /metrics/*
	respond @metrics "Not Found" 404

	# Headers de Segurança (LOW-3)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Rotas da API v1 e WebSockets encaminhadas para o backend Go
	@api path /api/* /api
	reverse_proxy @api backend:8080

	# Demais rotas (telas Next.js, static files, login) encaminhadas para o frontend
	reverse_proxy frontend:3000
}

http://api.stock-pulse.localhost {
	encode zstd gzip

	# Bloqueia acesso externo ao endpoint de métricas do Prometheus (LOW-4)
	@metrics path /metrics /metrics/*
	respond @metrics "Not Found" 404

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy backend:8080
}
