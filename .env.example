# Arquivo de exemplo de variáveis de ambiente. Copie para .env e altere os valores.

# Configurações do Banco de Dados
POSTGRES_USER=root
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=stockpulse

# Configurações do Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Worker Intervals (Opcional, Padrão: 6h)
# DIVIDEND_WORKER_INTERVAL=6h
# DAILY_WORKER_INTERVAL=6h
# FI_WORKER_INTERVAL=6h
# ANBIMA_WORKER_INTERVAL=6h
# ALERT_CHECK_INTERVAL=1m

# Redis Cache TTL (Opcional, Padrões listados abaixo)
# REDIS_TTL_QUOTES=60s
# REDIS_TTL_DIVIDENDS=12h
# REDIS_TTL_FUNDAMENTALS=12h
# REDIS_TTL_EXCHANGE_RATES=12h

# Segurança e Integrações (JWT_SECRET deve ter no mínimo 32 caracteres, ex: openssl rand -base64 32)
JWT_SECRET=sua_chave_secreta_aqui_com_no_minimo_32_caracteres
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=12h
MOCK_EXTERNAL_APIS=false

# URLs da Aplicação (Opcional se rodando localmente via localhost)
# Se rodar em servidor com outro IP, configure com o IP/domínio da sua máquina:
# FRONTEND_URL=http://SEU_IP_DO_SERVIDOR:3000
# NEXT_PUBLIC_API_URL=http://SEU_IP_DO_SERVIDOR:8080/api/v1
